#!/bin/bash
# Laptop-side CLI for remote appliance ops (SSH allowlist boundary).
# Product repos stay on the device; this repo is the orchestrator only.

set -euo pipefail

MPE_CLI_ROOT="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/.." && pwd)"
MPE_CLI_NAME="$(basename "$0")"

# Bump on any change consuming repos may pin against: new subcommand, new test
# suite, or changed exit-code contract. See commands/version.sh.
MPE_CLI_VERSION="1.1.0"

# shellcheck source=../lib/config.sh
source "$MPE_CLI_ROOT/lib/config.sh"
# shellcheck source=../lib/ssh.sh
source "$MPE_CLI_ROOT/lib/ssh.sh"
# shellcheck source=../lib/validate.sh
source "$MPE_CLI_ROOT/lib/validate.sh"

mpe_cli_usage() {
    cat <<EOF
Usage: $MPE_CLI_NAME <command> [options]

Read-only (agent-safe):
  ping                      Test SSH to the appliance
  status                    Service active/failed summary
  logs <surge|touch|looper|watchdog|jackd> [-n N]   Recent logs (default $MPE_LOG_LINES_DEFAULT, max $MPE_LOG_LINES_MAX)
  osc-check                 Surge OSC ports + process check
  diagnose                  Full appliance diagnostics (read-only)
  sysinfo                   Board, kernel/preempt, EEPROM, RT limits, audio config
  power [seconds]           Sample ARM clock/throttle/volts under load (default 15s)
  test [local|pi] [suite]   Run unit tests (default: local, all); test list for suites
  test coverage [local|pi]  Fail if any test module belongs to no suite
  midi-list [local|pi]      USB + ALSA MIDI port snapshot (read-only)
  version [--check x.y.z]   Print version, or assert a minimum (exit 1 if older)

Operations:
  record [file] [fps]       Record touch UI (Ctrl+C to stop)
  pull-videos [options]     Download ~/mpe-demo-*.mkv from appliance
    -o, --output DIR        Destination (default: ./recordings)
    --delete-source         Remove from appliance after download
  restart <surge|touch|looper|jackd|watchdog|all> Restart fixed systemd units only
  rt status                  Show configured + live SCHED_FIFO state (read-only)
  rt surge|looper <1-95|off> Set realtime priority; restart that service
  jack <sub>                 JACK graph-server experiment (never the boot path)
                             install|devices|start|surge|ports|status|logs|stop
                             'jack stop' is the rollback to systemd Surge
  engine <sub>               Audio engine status + soak injections (production path)
                             status|set jack|alsa|mask-jackd|unmask-jackd|start-jackd|sync-units|kill-jackd
  looper deploy [branch]     Pull yolo branch on Pi + restart mpe-looper.service
  looper restart             Restart mpe-looper.service only
  looper debug on|off        Toggle period-overrun logging (/etc/mpe/mpe.env)
  looper buffer 512|1024     Set Surge + looper period; restart both services
  profile status             Show MPE_AUDIO_PROFILE + gadget units
  profile set <name>         standalone | usb-host | usb-host-session

Config: \$MPE_CLI_CONFIG (default: ~/.config/mpe/mpe.env)
Security: AGENTS.md in this repo · pattern: OM-Repo Docs/appliance-cli-pattern.md
EOF
}

mpe_cli_dispatch() {
    local cmd="${1:-}"
    if [ -z "$cmd" ] || [ "$cmd" = "-h" ] || [ "$cmd" = "--help" ] || [ "$cmd" = help ]; then
        mpe_cli_usage
        exit 0
    fi
    shift

    local handler=""
    case "$cmd" in
        ping) handler=ping ;;
        status) handler=status ;;
        logs) handler=logs ;;
        osc-check | osc) handler=osc-check ;;
        diagnose) handler=diagnose ;;
        sysinfo) handler=sysinfo ;;
        power) handler=power ;;
        test) handler=test ;;
        version | --version | -V) handler=version ;;
        midi-list | midilist | midi) handler=midi-list ;;
        restart) handler=restart ;;
        rt) handler=rt ;;
        jack) handler=jack ;;
        engine) handler=engine ;;
        looper) handler=looper ;;
        profile) handler=profile ;;
        record) handler=record ;;
        pull-videos | pull) handler=pull-videos ;;
        *)
            echo "$MPE_CLI_NAME: unknown command: $cmd" >&2
            echo "Run '$MPE_CLI_NAME help' for usage." >&2
            exit 1
            ;;
    esac

    # shellcheck source=/dev/null
    source "$MPE_CLI_ROOT/commands/${handler}.sh"
    "cmd_${handler//-/_}" "$@"
}

mpe_cli_dispatch "$@"
