# Laptop SSH config for mpe CLI (and optional deploy-script override via product repo config/mpe.env)
#
# Copy to: ~/.config/mpe/mpe.env
# chmod 600 ~/.config/mpe/mpe.env

# Appliance SSH target
PI_HOST=raspberrypi.local
# Required — must match the username set when you flashed the SD card
PI_USER=your-pi-username
SSH_KEY=$HOME/.ssh/your_pi_key

# Remote product repo path on the appliance (optional)
# Must be an ABSOLUTE path, characters [A-Za-z0-9_./-] only, no "..".
# This value is interpolated into a shell command that runs on the appliance,
# so it is validated and shell-quoted. It is read from THIS FILE ONLY — an
# exported PI_MPE_MODULE in the environment is ignored by design.
# PI_MPE_MODULE=/home/your-pi-username/MPE-Module

# Laptop clone for `mpe test local` (optional)
# LOCAL_MPE_MODULE=$HOME/Documents/GitHub/MPE-Module

# Named suites: mpe test list (all, apc, looper, midi, touch, audio, surge, patch, calibration, …)
